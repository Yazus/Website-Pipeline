{
  "name": "website-pipeline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An agency-grade website pipeline: brief, content, design system, build, QA gates, review, deploy.",
  "scripts": {
    "site": "node bin/site.mjs",
    "new": "node bin/site.mjs new",
    "art": "node bin/site.mjs art",
    "build": "node bin/site.mjs build",
    "check": "node bin/site.mjs check",
    "review": "node bin/site.mjs review",
    "deploy": "node bin/site.mjs deploy",
    "pipeline": "node bin/site.mjs run",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "browserslist": "^4.29.4",
    "chrome-launcher": "^1.2.2",
    "html-validate": "^11.17.0",
    "lighthouse": "^13.5.0",
    "lightningcss": "^1.33.0",
    "linkedom": "^0.18.14",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "yaml": "^2.9.1"
  }
}
